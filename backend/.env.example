# HerbSense Backend Configuration
# Add your Roboflow Private API Key from: https://app.roboflow.com/settings/api
ROBOFLOW_API_KEY=your_roboflow_private_api_key_here

# Express Server Port
PORT=3001

# Allowed Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Optional second model for a plain-language plant description.
# Any OpenAI-compatible chat completions provider can be used.
DESCRIPTION_API_KEY=your_description_model_api_key_here
DESCRIPTION_API_URL=https://integrate.api.nvidia.com/v1
DESCRIPTION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# JWT Secret for user authentication (change to a random string)
JWT_SECRET=your_jwt_secret_key_here

# Supabase Cloud Database (PostgreSQL)
# Format: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your_password@db.your_project_ref.supabase.co:5432/postgres
