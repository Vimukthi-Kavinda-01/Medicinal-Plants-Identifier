# HerbSense Backend Configuration
# Add your Roboflow Private API Key from: https://app.roboflow.com/settings/api
ROBOFLOW_API_KEY=your_roboflow_private_api_key_here

# Optional second model for a plain-language plant description.
# Any OpenAI-compatible chat completions provider can be used.
DESCRIPTION_API_KEY=your_description_model_api_key_here
DESCRIPTION_API_URL=https://api.openai.com/v1/chat/completions
DESCRIPTION_MODEL=gpt-4o-mini

# Express Server Port
PORT=3001

# Allowed Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

